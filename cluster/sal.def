Bootstrap: docker
From: pytorch/pytorch:2.2.1-cuda12.1-cudnn8-devel

%labels
    BuildDate 2026-09-13

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONNOUSERSITE=1
    export PIP_NO_CACHE_DIR=1

%files
    requirements.txt /opt/sal/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libsndfile1 \
        ffmpeg \
        git \
        && rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir -r /opt/sal/requirements.txt

%test
    python - <<'PY'
import sys

import hydra
import lightning
import matplotlib
import numpy
import s3prl
import torch
import torchaudio

assert sys.version_info[:2] == (3, 10), sys.version
assert torch.__version__.split("+")[0] == "2.2.1", torch.__version__
assert torchaudio.__version__.split("+")[0] == "2.2.1", torchaudio.__version__
assert torch.version.cuda == "12.1", torch.version.cuda
print("SAL container build test passed")
PY

%runscript
    exec python "$@"
